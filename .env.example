# Local development only. Copy to .env. Do not put real Azure secrets here.
APP_ENV=local
LOG_LEVEL=INFO

# Local Docker Compose PostgreSQL. Not an Azure database.
DATABASE_URL=postgresql+psycopg://recruitment:recruitment@localhost:5432/recruitment

# mock is explicit and must be shown in the product.
# foundry requires Azure OpenAI credentials and never silently falls back to mock.
MODEL_PROVIDER=mock
# AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
# AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Goals Library Localization (Azure AI Translator). Required for live translation jobs.
# AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
# AZURE_TRANSLATOR_KEY=
# AZURE_TRANSLATOR_REGION=eastus
# Paid S1 fallback. Used only when an admin turns it on in Settings.
# AZURE_TRANSLATOR_PAID_ENDPOINT=https://api.cognitive.microsofttranslator.com
# AZURE_TRANSLATOR_PAID_KEY=
# AZURE_TRANSLATOR_PAID_REGION=eastus
# Send every batch to the paid key and skip the free key (use when F0 is exhausted).
# AZURE_TRANSLATOR_PAID_ONLY=false
# GOALS_LOCALIZATION_MAX_UPLOAD_MB=50
# GOALS_LOCALIZATION_TRANSLATE_BATCH_SIZE=50
# GOALS_LOCALIZATION_MAX_CORRECTION_ATTEMPTS=2

# Auth cookies. Keep cookie_secure=false for local HTTP only.
SESSION_COOKIE_NAME=ri_session
CSRF_COOKIE_NAME=ri_csrf
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_TTL_HOURS=12
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=300
